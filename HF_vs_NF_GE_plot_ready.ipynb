        "# Define bar colors based on morph upregulation using the original palette\n",
        "bar_colors = [\n",
        "    MORPH_COLORS['Fluorescent'] if val > 0 else MORPH_COLORS['Non-fluorescent']\n",
        "    for val in df_sorted['plot_lfc']\n",
